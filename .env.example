# ====================================================================
# STUDENT REPORT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
#
# IMPORTANT: Provide your Neon PostgreSQL credentials below.
# Do NOT commit your actual credentials to version control.
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
#
# --------------------------------------------------------------------
# NEON POSTGRESQL DATABASE CONFIGURATION (Supplied by user)
# --------------------------------------------------------------------
# Neon pooled connection (recommended for web application traffic):
# jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=jdbc:postgresql://<NEON_POOLED_HOST>/<NEON_DB_NAME>?sslmode=require&channel_binding=require

# Neon direct connection (for DDL/Flyway migrations if needed):
DATABASE_DIRECT_URL=jdbc:postgresql://<NEON_DIRECT_HOST>/<NEON_DB_NAME>?sslmode=require&channel_binding=require

DATABASE_USERNAME=<NEON_USERNAME>
DATABASE_PASSWORD=<NEON_PASSWORD>

# --------------------------------------------------------------------
# APPLICATION SECURITY & JWT CONFIGURATION
# --------------------------------------------------------------------
# Secret must be at least 256 bits (32+ characters) for HS256/HS384/HS512
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_for_security
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# CORS Configuration (Frontend URLs allowed to connect)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookie security settings (Set to true in production HTTPS)
COOKIE_SECURE=false

# --------------------------------------------------------------------
# FRONTEND CONFIGURATION
# --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
